<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConfiOS.BuildingBlocks.Application\ConfiOS.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\ConfiOS.BuildingBlocks.Domain\ConfiOS.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\ConfiOS.BuildingBlocks.Infrastructure\ConfiOS.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No designer generator: the ErrorMessages type is hand-written, and a generated one
      would collide with it in the same namespace. Lookups are by error code string.
    -->
    <EmbeddedResource Include="Localization\ErrorMessages.resx" />
    <EmbeddedResource Include="Localization\ErrorMessages.fr.resx" />
    <EmbeddedResource Include="Localization\ErrorMessages.rw.resx" />
  </ItemGroup>

</Project>
